rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper to validate complete structure of ChatSession on create
    function isValidChatSession(data) {
      return data.keys().hasAll(['id', 'title', 'userId', 'createdAt', 'updatedAt'])
        && data.keys().size() == 5
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.userId is string && data.userId == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // Helper to validate complete structure of Message on create
    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'role', 'content', 'createdAt'])
        && data.id is string
        && data.content is string
        && data.createdAt == request.time;
    }

    // Helper to validate complete structure of Personalization Settings on create/update
    function isValidPersonalization(data) {
      return data.keys().hasAll(['aiTone', 'customPersonality', 'userProfile', 'updatedAt'])
        && data.keys().size() == 4
        && data.aiTone is string && data.aiTone.size() <= 64
        && data.customPersonality is string && data.customPersonality.size() <= 2000
        && data.userProfile is string && data.userProfile.size() <= 2000
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      match /settings/{settingId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(settingId)
          && isValidPersonalization(incoming());
      }

      match /usage_logs/{logId} {
        allow get, list, create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /sessions/{sessionId} {
      allow read, delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn() 
        && isValidId(sessionId)
        && isValidChatSession(incoming());
        
      allow update: if isSignedIn()
        && resource != null
        && resource.data.userId == request.auth.uid
        && incoming().userId == resource.data.userId
        && incoming().createdAt == resource.data.createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Rename or update title/updatedAt
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt'])
          && incoming().title is string && incoming().title.size() <= 256
        );

      match /messages/{messageId} {
        allow read, delete: if isSignedIn() 
          && (
            !exists(/databases/$(database)/documents/sessions/$(sessionId)) 
            || get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid
          );
          
        allow create: if isSignedIn()
          && isValidId(messageId)
          && exists(/databases/$(database)/documents/sessions/$(sessionId))
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid
          && isValidMessage(incoming());
          
        allow update: if false; // Messages are immutable once written in our chat history
      }
    }
  }
}
